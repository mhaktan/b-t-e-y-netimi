[
  {
    "id": "flow-BudgetRequest-approval",
    "name": "BudgetRequest Approval Flow",
    "description": "Auto-generated approval flow for BudgetRequest. Customize email templates and add conditions as needed.",
    "resourceName": "BudgetRequest",
    "enabled": true,
    "variables": [
      {
        "name": "assigneeEmail",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "creatorEmail",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "departmentEmails",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "formLink",
        "type": "string",
        "defaultValue": ""
      }
    ],
    "nodes": [
      {
        "id": "BudgetRequest-approval-trigger",
        "type": "trigger",
        "label": "On BudgetRequest Submit",
        "position": {
          "x": 300,
          "y": 50
        },
        "trigger": {
          "type": "on-field-change",
          "resourceName": "BudgetRequest",
          "fieldName": "status"
        }
      },
      {
        "id": "BudgetRequest-approval-condition",
        "type": "condition",
        "label": "Status = PendingManagerApproval?",
        "position": {
          "x": 300,
          "y": 160
        },
        "condition": {
          "logic": "and",
          "rules": [
            {
              "field": "triggerData.status",
              "operator": "equals",
              "value": "1"
            }
          ]
        }
      },
      {
        "id": "BudgetRequest-approval-approval",
        "type": "approval",
        "label": "BudgetRequest Approval",
        "position": {
          "x": 300,
          "y": 280
        },
        "approval": {
          "steps": [
            {
              "name": "Yönetici Onayı",
              "assigneeType": "field",
              "assigneeValue": "managerApproverId",
              "actions": [
                {
                  "label": "Onayla",
                  "type": "approve"
                },
                {
                  "label": "Revize Et",
                  "type": "revise",
                  "requiredFields": [
                    "revisionNote"
                  ]
                }
              ]
            },
            {
              "name": "Finans Onayı",
              "assigneeType": "field",
              "assigneeValue": "financeApproverRole",
              "condition": {
                "logic": "and",
                "rules": [
                  {
                    "field": "totalAmountTRY",
                    "value": "50000",
                    "operator": "greater-than"
                  }
                ]
              },
              "actions": [
                {
                  "label": "Onayla",
                  "type": "approve"
                },
                {
                  "label": "Revize Et",
                  "type": "revise",
                  "requiredFields": [
                    "revisionNote"
                  ]
                }
              ]
            }
          ],
          "trackRevisionHistory": true,
          "onCompleteEvent": "BudgetRequest-approval-completed"
        }
      },
      {
        "id": "BudgetRequest-approval-email",
        "type": "action",
        "label": "Send Approval Email",
        "position": {
          "x": 300,
          "y": 400
        },
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{assigneeEmail}}",
            "subject": "{{triggerData.title}} — Onayınızı Bekliyor",
            "body": "<p>Sayın Onaycı,</p><p><strong>{{triggerData.title}}</strong> başlıklı bütçe talebi onayınızı beklemektedir.</p><p>Gerekçe: {{triggerData.justification}}</p>",
            "contentType": "html"
          }
        }
      },
      {
        "id": "BudgetRequest-approval-completion-trigger",
        "type": "trigger",
        "label": "On BudgetRequest Approved",
        "position": {
          "x": 700,
          "y": 50
        },
        "trigger": {
          "type": "manual",
          "resourceName": "BudgetRequest"
        }
      },
      {
        "id": "BudgetRequest-approval-completion-email",
        "type": "action",
        "label": "Send Completion Email",
        "position": {
          "x": 700,
          "y": 160
        },
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{creatorEmail}}",
            "cc": "{{departmentEmails}}",
            "subject": "{{triggerData.formNo}} — Tum onaylar tamamlandi",
            "body": "<p>{{triggerData.formNo}} numarali formun onay sureci tamamlanmistir.</p>",
            "contentType": "html"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "gen_1793038041746_1",
        "sourceNodeId": "BudgetRequest-approval-trigger",
        "targetNodeId": "BudgetRequest-approval-condition"
      },
      {
        "id": "gen_1793038041746_2",
        "sourceNodeId": "BudgetRequest-approval-condition",
        "targetNodeId": "BudgetRequest-approval-approval",
        "branch": "true"
      },
      {
        "id": "gen_1793038041746_3",
        "sourceNodeId": "BudgetRequest-approval-approval",
        "targetNodeId": "BudgetRequest-approval-email"
      },
      {
        "id": "gen_1793038041746_4",
        "sourceNodeId": "BudgetRequest-approval-completion-trigger",
        "targetNodeId": "BudgetRequest-approval-completion-email"
      }
    ],
    "createdAt": "2026-10-26T18:07:21.746Z",
    "updatedAt": "2026-10-26T18:07:21.746Z"
